{
  "name": "@limen/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=../../.env src/index.ts",
    "import-registrations": "node --env-file-if-exists=../../.env src/registration.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "check:devnet": "node --env-file-if-exists=../../.env --test --test-concurrency=1 \"src/devnet/*.check.ts\"",
    "seed": "node --env-file-if-exists=../../.env src/seed.ts",
    "station-link": "node --env-file-if-exists=../../.env src/station-link.ts"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4"
  },
  "devDependencies": {
    "litesvm": "0.8.0"
  }
}
