{
  "unit": "E-04",
  "about": "Ten QR texts and the class each one owes. The last two are malformed Solana Pay URLs and owe \"other\". The public keys here are 32-byte values generated at random for this fixture.",
  "cases": [
    {
      "name": "station check-in QR",
      "text": "limen:station:eyJzdGF0aW9uIjoiQSJ9.c2lnbmF0dXJl",
      "owed": {
        "type": "station",
        "text": "limen:station:eyJzdGF0aW9uIjoiQSJ9.c2lnbmF0dXJl"
      }
    },
    {
      "name": "Solana Pay SOL transfer request",
      "text": "solana:9MJAtNQnuUcAKm6LXbobqTRXySgScVyUEAavmPUhnP3k?amount=1&label=Build%20Station&message=Coffee&memo=Order42",
      "owed": {
        "type": "solana-pay",
        "request": "transfer",
        "recipient": "9MJAtNQnuUcAKm6LXbobqTRXySgScVyUEAavmPUhnP3k"
      }
    },
    {
      "name": "Solana Pay SPL token transfer request",
      "text": "solana:9MJAtNQnuUcAKm6LXbobqTRXySgScVyUEAavmPUhnP3k?amount=0.01&spl-token=9FDVRcwfqnN19PRjaikWMfGKz9vt5YFa8r8h9Juj3qpw",
      "owed": {
        "type": "solana-pay",
        "request": "transfer",
        "recipient": "9MJAtNQnuUcAKm6LXbobqTRXySgScVyUEAavmPUhnP3k"
      }
    },
    {
      "name": "Solana Pay transaction request, link not encoded",
      "text": "solana:https://example.com/solana-pay",
      "owed": {
        "type": "solana-pay",
        "request": "transaction",
        "link": "https://example.com/solana-pay"
      }
    },
    {
      "name": "Solana Pay transaction request, link with a query, encoded",
      "text": "solana:https%3A%2F%2Fexample.com%2Fsolana-pay%3Forder%3D12345",
      "owed": {
        "type": "solana-pay",
        "request": "transaction",
        "link": "https://example.com/solana-pay?order=12345"
      }
    },
    {
      "name": "https link",
      "text": "https://example.org/schedule",
      "owed": { "type": "url", "href": "https://example.org/schedule" }
    },
    {
      "name": "http link",
      "text": "http://example.net/menu?table=4",
      "owed": { "type": "url", "href": "http://example.net/menu?table=4" }
    },
    {
      "name": "plain text",
      "text": "Wi-Fi password is on the whiteboard",
      "owed": { "type": "other", "reason": "unrecognized" }
    },
    {
      "name": "malformed: recipient is not base58",
      "text": "solana:0OIl-not-a-public-key?amount=1",
      "owed": { "type": "other", "reason": "malformed-solana-pay" }
    },
    {
      "name": "malformed: transaction request link is http, not https",
      "text": "solana:http%3A%2F%2Fexample.com%2Fsolana-pay",
      "owed": { "type": "other", "reason": "malformed-solana-pay" }
    }
  ]
}
