# Copy to .env and fill in locally. .env is gitignored. Names only here, never values (rule 8).

# Solana devnet RPC endpoint, which may carry an RPC provider key. Devnet only (D-03).
SOLANA_RPC_URL=

# Path to the organizer keypair file, kept outside git.
ORGANIZER_KEYPAIR_PATH=

# Secret salt for registration ID hashes (E-07), at least 32 characters. Changing it orphans
# every imported registration. Generate with: openssl rand -base64 32
REGISTRATION_SALT=

# Optional API settings. Defaults: limen.db in the working directory (services/api under
# npm start), host 127.0.0.1, port 8787.
DATABASE_PATH=
API_HOST=
API_PORT=

# Bearer token for the triage dashboard's JSON routes (E-12), at least 32 characters. Unset, those
# routes answer 503. Generate one with: openssl rand -base64 32
TRIAGE_TOKEN=

# Chainabuse API credentials, used only by E-13 behind its feature flag.
CHAINABUSE_API_KEY=
