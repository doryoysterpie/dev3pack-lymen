# Copy to .env and fill in locally. .env is gitignored. Names only here, never values (rule 8).

# Solana devnet RPC endpoint, which may carry an RPC provider key. Devnet only (D-03).
SOLANA_RPC_URL=

# The app's devnet RPC endpoint (apps/mobile). Expo builds this value into the app,
# so it must not carry a provider key. Left empty, the app uses the public devnet
# endpoint. The app checks the endpoint's genesis hash and stops on any other cluster.
EXPO_PUBLIC_SOLANA_RPC_URL=

# Path to the organizer keypair file, kept outside git.
ORGANIZER_KEYPAIR_PATH=

# Mobile app (E-10, app side): the limen API base URL the app sends reports to. Expo builds
# EXPO_PUBLIC_ variables into the app, so this holds an address, never a secret. Set it in the
# shell that runs the app. On the Android emulator the host's API is http://10.0.2.2:8787.
EXPO_PUBLIC_API_URL=

# Chainabuse API credentials, used only by E-13 behind its feature flag.
CHAINABUSE_API_KEY=
