# Dependencies and build output
node_modules/
dist/
build/
.expo/
coverage/
*.log

# Secrets: keypairs, the RPC key and Chainabuse credentials stay out of git (rule 8)
.env
.env.*
!.env.example
keys/
*.keypair.json
id.json
# Station display links hold a station's display token (E-03). The link tool refuses to write
# inside the repository, so none should be here; these patterns are a second guard, for link
# files by their .url name and for the .station-links/ folder where they used to go.
*.url
.station-links/
# The plaintext registration list the import tool reads (E-07). Only salted hashes of its IDs
# belong in the database; the list stays out of git and is deleted after the import.
.registrations/

# Local databases
*.db
*.sqlite
*.sqlite3

# OS files
.DS_Store
