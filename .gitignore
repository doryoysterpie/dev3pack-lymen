# Dependencies and build output
node_modules/
dist/
build/
.expo/
coverage/
*.log

# Secrets: keypairs, the RPC key and Chainabuse credentials stay out of git (rule 8)
.env
.env.*
!.env.example
keys/
*.keypair.json
id.json
# Legacy: an earlier version of E-03 wrote station display links, which hold a display token, as
# *.url files, some in a .station-links/ folder. They stay ignored.
*.url
.station-links/

# Local databases
*.db
*.sqlite
*.sqlite3

# OS files
.DS_Store
# Key files by extension, anywhere. Committed key material is caught by content in CI, whatever
# its name (services/api/src/key-scan.ts).
*.der
*.pem
*.key
*.p12
