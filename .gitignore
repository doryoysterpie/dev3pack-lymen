# Dependencies and build output
node_modules/
dist/
build/
.expo/
coverage/
*.log

# Secrets: keypairs, the RPC key and Chainabuse credentials stay out of git (rule 8)
.env
.env.*
!.env.example
keys/
*.keypair.json
id.json
# Legacy: an earlier version of E-03 wrote station display links, which hold a display token, as
# *.url files, some in a .station-links/ folder. They stay ignored.
*.url
.station-links/

# Local databases
*.db
*.sqlite
*.sqlite3

# OS files
.DS_Store
# No key belongs in the station page's folder: key-shaped files there stay out of git.
apps/station/**/*.json
!apps/station/package.json
apps/station/**/*.pem
apps/station/**/*.key
apps/station/**/*.p12
apps/station/**/*.pfx
